# ==============================================================================
# GOLD AI BOT V2 — MASTER ENVIRONMENT & CONFIGURATION SPECIFICATION
# Institutional XAU/USD Decision & Lifecycle Engine
# ==============================================================================
# CLASSIFICATION NOTICE:
# - PART 1 contains TRUE SECRETS & AUTHENTICATION CREDENTIALS. These are server-only
#   and must NEVER be exposed to the client bundle or committed with live values.
# - PART 2 contains NORMAL OPERATIONAL CONFIGURATION VALUES. These are NOT secrets,
#   are accessible to the backend, and are configurable via Dashboard Settings.
# ==============================================================================

# ==============================================================================
# PART 1: SENSITIVE SECRETS & AUTHENTICATION CREDENTIALS (SERVER-ONLY / PRIVATE)
# ==============================================================================
# These credentials provide privileged access to external APIs and databases.
# Keep strictly confidential. Do NOT expose to client or version control.

# 1.1 Supabase Service Role Key (Server-Side Only - bypasses Row Level Security)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"

# 1.2 OpenRouter / LLM Authentication API Keys
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_API_KEY="your_gemini_api_key_here"

# 1.3 Telegram Bot API Token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_channel_or_chat_id_here"

# 1.4 Macroeconomic News API Key
NEWS_API_KEY="your_news_provider_api_key_here"

# ==============================================================================
# PART 2: OPERATIONAL CONFIGURATION VALUES (NON-SECRETS / DASHBOARD CONFIGURABLE)
# ==============================================================================
# These are normal operational parameters, safety switches, and risk limits.
# They are NOT sensitive secrets and are fully manageable through the Dashboard.

# 2.1 Core Runtime
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# 2.2 Market Data Provider & Feed Parameters
MARKET_DATA_PROVIDER="biquote"
BIQUOTE_API_KEY=""
BIQUOTE_BASE_URL="https://biquote.io"
BIQUOTE_WS_URL="wss://biquote.io/ws"
SYMBOL="XAUUSD"

# 2.3 Candlestick Historical Depth (Non-secret)
CANDLE_WINDOW_1M=200
CANDLE_WINDOW_5M=300
CANDLE_WINDOW_15M=200
CANDLE_WINDOW_1H=150

# 2.4 Scanner & Staleness Windows
SCANNER_INTERVAL_SECONDS=60
MAX_ALLOWED_DATA_STALENESS_SECONDS=120

# 2.5 AI Reasoning & Timeout (Non-secret)
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_REASONING_TIMEOUT_MS=30000

# 2.6 Risk & Capital Engine Defaults (Non-secret)
STARTING_CAPITAL=100.00
RISK_PERCENT_PER_TRADE=1.00
MAX_DAILY_RISK_PERCENT=3.00
MAX_CONCURRENT_TRADES=2
MAX_ALLOWED_SL_DISTANCE=12.00
MIN_RISK_REWARD_RATIO=1.50
MAX_DRAWDOWN_LIMIT_PERCENT=10.00

# 2.7 Signal Quality & Thresholds
MIN_CONFIDENCE_THRESHOLD=70
MIN_QUALITY_SCORE=65

# 2.8 Deduplication & Spatial POI Zone Tolerance (Non-secret)
DEDUP_POI_ZONE_TOLERANCE_USD=1.00
DEDUP_ACTIVE_WINDOW_MINUTES=60
DEDUP_STRUCTURE_ANCHOR_TOLERANCE_USD=0.30

# 2.9 Trade Monitoring & Position Management (Non-secret)
MONITOR_PRICE_POLL_INTERVAL_SECONDS=5
BREAKEVEN_TRIGGER_R=1.0
PARTIAL_CLOSE_TP1_RATIO=0.50
TRAILING_STOP_ENABLED="false"
REVERSAL_WATCH_ENABLED="true"

# 2.10 Telegram Dispatch Governance (Non-secret)
TELEGRAM_ENABLED=false
TELEGRAM_RATE_LIMIT_PER_MINUTE=10
TELEGRAM_NOTIFY_ON_TP1="true"
TELEGRAM_NOTIFY_ON_TP2="true"
TELEGRAM_NOTIFY_ON_SL="true"
TELEGRAM_NOTIFY_ON_INVALIDATION="true"
TELEGRAM_NOTIFY_ON_REVERSAL_WATCH="true"
TELEGRAM_NOTIFY_ON_EARLY_EXIT="true"

# 2.11 News Intelligence Windows
NEWS_HIGH_IMPACT_PRE_WINDOW_MINUTES=30
NEWS_HIGH_IMPACT_POST_WINDOW_MINUTES=15

# 2.12 Execution Governance & Safety Stop (Non-secret)
# EMERGENCY_KILL_SWITCH: Operationally critical safety stop, NOT a credential/secret.
# Visible in Dashboard Settings to safely halt trade execution and order routing.
AUTO_TRADING=false
EMERGENCY_KILL_SWITCH=true
BROKER_ADAPTER="mock"
